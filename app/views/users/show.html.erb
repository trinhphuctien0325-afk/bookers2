<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render "books/info", user: @user, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>

      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>

 <tbody>
   <% @books.each do |book| %>
     <tr>
       <td>
       <%= link_to user_path(book.user) do %>
          <%= book.user.name %>
       <% end %>
              </td>

              <td>
                <%= link_to book.title, book_path(book) %>
              </td>

              <td>
 <%= book.body %>
   </td>
   </tr>
   <% end %>
   </tbody>
  </table>
  <h2>投稿数の前日比・前週比</h2>

<table class="table">
  <thead>
    <tr>
      <th>今日の投稿数</th>
      <th>前日の投稿数</th>
      <th>前日比</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= @today_book %></td>
      <td><%= @yesterday_book %></td>
      <td>
        <% if @yesterday_book == 0 %>
          前日の投稿なし
        <% else %>
          <%= (@today_book.to_f / @yesterday_book * 100).round %>%
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<table class="table">
  <thead>
    <tr>
      <th>今週の投稿数</th>
      <th>先週の投稿数</th>
      <th>前週比</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= @this_week_book %></td>
      <td><%= @last_week_book %></td>
      <td>
        <% if @last_week_book == 0 %>
          先週の投稿なし
        <% else %>
          <%= (@this_week_book.to_f / @last_week_book * 100).round %>%
        <% end %>
      </td>
    </tr>
  </tbody>
</table>
<h2>7日間分の投稿数</h2>

<table class="table">
  <thead>
    <tr>
      <th>6日前</th>
      <th>5日前</th>
      <th>4日前</th>
      <th>3日前</th>
      <th>2日前</th>
      <th>1日前</th>
      <th>今日</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td><%= @books_6_days_ago %></td>
      <td><%= @books_5_days_ago %></td>
      <td><%= @books_4_days_ago %></td>
      <td><%= @books_3_days_ago %></td>
      <td><%= @books_2_days_ago %></td>
      <td><%= @books_1_day_ago %></td>
      <td><%= @books_today %></td>
    </tr>
  </tbody>
</table>
<canvas id="myChart"></canvas>
<script>
  const ctx = document.getElementById('myChart');

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['6日前', '5日前', '4日前', '3日前', '2日前', '1日前', '今日'],
      datasets: [{
        label: '投稿した本の数',
        data: [
          <%= @books_6_days_ago %>,
          <%= @books_5_days_ago %>,
          <%= @books_4_days_ago %>,
          <%= @books_3_days_ago %>,
          <%= @books_2_days_ago %>,
          <%= @books_1_day_ago %>,
          <%= @books_today %>
        ]
      }]
    }
  });
</script>
<%= form_with url: user_path(@user), method: :get, local: true do |f| %>
  <%= f.date_field :date %>
  <%= f.submit "検索", class: "btn btn-primary" %>
<% end %>

<% if @search_book.present? %>
  <h2>検索結果</h2>

  <table class="table">
    <thead>
      <tr>
        <th>投稿数</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= @search_book %></td>
      </tr>
    </tbody>
  </table>
<% end %>
   </div>

  </div>
</div>