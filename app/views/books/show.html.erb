<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render "books/info", user: @book.user, book: Book.new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>

      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= link_to user_path(@book.user) do %>
                <%= image_tag @book.user.get_profile_image, size: "80x80" %><br>
                <%= @book.user.name %>
              <% end %>
            </td>

            <td>
              <%= @book.title %>
            </td>

            <td>
              <%= @book.body %>
            </td>
   <td>
  <%= turbo_frame_tag dom_id(@book, :favorite) do %>
    <%= render "favorites/favorite_btn", book: @book %>
  <% end %>
</td>
            <% if @book.user == Current.user %>
              <td>
                <%= link_to "Edit", edit_book_path(@book), class: "btn btn-success btn-sm" %>
              </td>

              <td>
                <%= link_to "Destroy", book_path(@book),
                            data: { turbo_method: :delete },
                            class: "btn btn-danger btn-sm" %>
              </td>
            <% end %>
          </tr>
        </tbody>
        </table>
      <div id="comments">
  <%= render "book_comments/comments", book: @book %>
</div>
<div id="comment_form">
  <%= form_with model: [@book, @book_comment] do |f| %>
    <%= f.text_area :comment %>
    <%= f.submit "送信" %>
  <% end %>
</div>

    </div>
  </div>
</div>